{
  "manifest_version": 3,
  "name": "Seller Flex 批量库存助手",
  "version": "0.7.3",
  "minimum_chrome_version": "114",
  "description": "Pack 一键展开全部订单、全选导出至 ERP 自动分拣，生成 API 标签和带图备货单；保留库存流程。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://htcerp.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HTC ERP 库存连接",
    "default_popup": "connection.html"
  },
  "options_ui": {
    "page": "connection.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://sellerflex.amazon.com/*"
      ],
      "js": [
        "preflight.js",
        "manual-storage.js",
        "inventory.js",
        "live-content.js",
        "pack-all.js",
        "pack-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://htcerp.app/*"
      ],
      "js": [
        "erp-relay.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sellerflex.amazon.com/*"],
      "js": ["pack-export-main.js"],
      "world": "MAIN",
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}
