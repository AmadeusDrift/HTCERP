{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selection-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "selection-local-evidence"
    }
  ],
  "name": "selection-jobs",
  "limits": { "subrequests": 1000000 },
  "main": "apps/jobs/src/index.ts",
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "* * * * *",
      "*/30 * * * *"
    ]
  },
  "workflows": [
    {
      "binding": "RUNNER",
      "name": "selection-run",
      "limits": { "steps": 25000 },
      "class_name": "ResearchWorkflow"
    },
    {
      "binding": "ASSISTANT_RUNNER",
      "name": "selection-assistant",
      "class_name": "AssistantWorkflow"
    }
  ]
}
