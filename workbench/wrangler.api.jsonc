{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "selection-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "selection-local-evidence"
    }
  ],
  "name": "selection-api",
  "main": "apps/api/src/index.ts",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "workflows": [
    {
      "binding": "RUNNER",
      "name": "selection-run",
      "class_name": "ResearchWorkflow",
      "script_name": "selection-jobs"
    }
  ]
}
